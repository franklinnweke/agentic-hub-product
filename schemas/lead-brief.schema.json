{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-hub.local/schemas/lead-brief.schema.json",
  "title": "Agentic Hub Lead Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "account_id",
    "account_name",
    "website",
    "segment",
    "source",
    "summary",
    "review_status",
    "fit_score",
    "score_breakdown",
    "fit_rationale",
    "confidence",
    "evidence",
    "contacts",
    "missing_information",
    "disqualifiers",
    "suggested_angle",
    "recommended_next_action",
    "approval_gate"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "account_id": {
      "type": "string",
      "pattern": "^acct_[a-z0-9_]+$"
    },
    "account_name": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "minLength": 1
    },
    "segment": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "new",
        "researching",
        "needs_review",
        "approved",
        "rejected",
        "needs_more_info"
      ]
    },
    "review_note": {
      "type": "string"
    },
    "fit_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "score_breakdown": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "fit_rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_type",
          "source_url",
          "claim",
          "confidence",
          "captured_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "context",
          "source",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disqualifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_angle": {
      "type": "string"
    },
    "recommended_next_action": {
      "type": "string"
    },
    "approval_gate": {
      "type": "string",
      "minLength": 1
    }
  }
}
